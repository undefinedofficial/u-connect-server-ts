{
  "name": "@u-connect/server-ts",
  "version": "v3.0.0",
  "description": "High-performance RPC server",
  "type": "module",
  "license": "MIT",
  "author": "https://github.com/undefinedofficial",
  "repository": {
    "type": "git",
    "url": "https://github.com/undefinedofficial/u-connect-server-ts.git"
  },
  "scripts": {
    "dev": "tsx watch src/example/app.ts",
    "build": "pkgroll"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@u-connect/client-ts": "https://github.com/undefinedofficial/u-connect-client-ts#v1.3.1",
    "glob": "^13.0.6",
    "msgpackr": "^1.10.1",
    "pkgroll": "^2.27.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.61.0"
  },
  "peerDependencies": {
    "msgpackr": "^1.10.1",
    "uWebSockets.js": "*",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/*",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/core/index.cjs",
  "module": "./dist/core/index.mjs",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.cjs"
    },
    "./serializer/*": {
      "types": "./dist/serializer/*.d.ts",
      "import": "./dist/serializer/*.mjs",
      "require": "./dist/serializer/*.cjs"
    },
    "./transport/*": {
      "types": "./dist/transport/*.d.ts",
      "import": "./dist/transport/*.mjs",
      "require": "./dist/transport/*.cjs"
    }
  }
}
